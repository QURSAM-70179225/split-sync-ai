# --- Google Gemini ---
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# --- PayPal Sandbox ---
# developer.paypal.com -> Apps & Credentials -> (Sandbox) -> Create App
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Where PayPal sends the buyer after approving / cancelling (the Vite dev server)
FRONTEND_URL=http://localhost:5173

# Set to true to route each payment to the creditor's email as PayPal payee.
# Creditor emails must then be real PayPal *sandbox* accounts.
PAYPAL_USE_PAYEE_EMAIL=false

# Set to true to use the offline regex parser instead of Gemini (no API key needed)
AI_OFFLINE_MODE=false

DATABASE_URL=sqlite:///./splitsync.db
